# API (.env in apps/api)
DATABASE_URL="postgresql://saas_user:saas_password@localhost:5777/saas_db?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-random-string-at-least-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
FRONTEND_URL="http://localhost:3001"
COOKIE_DOMAIN="localhost"
NODE_ENV="development"

# Resend (optional, for email)
RESEND_API_KEY=""

# Frontend (.env.local in apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
